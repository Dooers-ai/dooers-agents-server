# Database (PostgreSQL)
AGENT_DATABASE_HOST=localhost
AGENT_DATABASE_PORT=5432
AGENT_DATABASE_USER=postgres
AGENT_DATABASE_NAME=agents
AGENT_DATABASE_PASSWORD=
AGENT_DATABASE_SSL=

# Managed Dooers RAG. In hosted agents this is injected by dooers-push.
# The runtime mints a Google OIDC token from the ambient tenant service account.
# DOOERS_RAG_SERVICE_URL=https://dooers-service-rag-<hash>.southamerica-east1.run.app

# Observability — optional overrides (platform defaults are used when unset):
#   pip install "dooers-agents-server[observability]"
# Defaults: AGENT_CORE_BASE_URL=https://api.dooers.ai
#           AGENT_OTEL_SERVICE_URL=https://observability.dooers.ai
#           OTEL_SERVICE_NAME=dooers-agent
# AGENT_CORE_BASE_URL=
# AGENT_OTEL_SERVICE_URL=
# OTEL_SERVICE_NAME=
